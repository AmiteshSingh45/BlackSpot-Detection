# New settings added — append these to your existing backend/.env

# ── Alert Engine ────────────────────────────────────────────────
# Blackspot rank score above which an alert is auto-generated (0–100 scale)
ALERT_RISK_THRESHOLD=70.0
# Comma-separated risk tiers that always trigger an alert
ALERT_CRITICAL_TIERS=CRITICAL,HIGH

# ── Weather API (OpenWeather) ───────────────────────────────────
# Get your free key at: https://openweathermap.org/api (1000 calls/day free)
# Leave empty to use fallback (no live weather, risk_multiplier = 1.0)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# Cache weather responses to avoid hitting API limits (seconds)
WEATHER_CACHE_TTL_SECONDS=600

# ── Highway Geocoding (OSM-based) ───────────────────────────────
# OSM relation ID for your highway. NH-48 (Mumbai–Delhi) = 17686
# Find your highway: https://www.openstreetmap.org/relation/17686
OSM_HIGHWAY_RELATION_ID=17686
# Approximate GPS centre of your highway stretch (for weather + fallback map)
HIGHWAY_CENTER_LAT=22.0
HIGHWAY_CENTER_LNG=77.0
# Chainage offset: km value at the START of the road segment (default 0)
HIGHWAY_CHAINAGE_START_KM=0.0
